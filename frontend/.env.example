# Required. Base URL of the deployed backend API (no trailing slash).
# Local dev: falls back to http://localhost:8000 if unset, so this can be
# omitted for `npm run dev` unless your backend runs on a different port.
# Production/preview (Vercel): must be set explicitly, e.g. the Render
# backend URL — https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000
