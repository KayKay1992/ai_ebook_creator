{
  "rewrites": [
    {
      "source": "/kenlibs/book/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest).*"
        }
      ],
      "destination": "https://kenlibs-backend.onrender.com/kenlibs/book/:id"
    },
    {
      "source": "/kenlibs/bundle/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest).*"
        }
      ],
      "destination": "https://kenlibs-backend.onrender.com/kenlibs/bundle/:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
