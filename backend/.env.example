# Server port. Render sets this itself in production — safe to leave unset
# there. Only matters for local dev (defaults to 5000 if unset).
PORT=8000

# MongoDB Atlas connection string. No fallback — the app fails fast at
# startup if this is missing rather than silently pointing at nothing.
MONGO_URI=

# Secret used to sign/verify JWTs. Use a long random value in production —
# anyone who has this can mint valid tokens for any user.
JWT_SECRET=

# Gemini API key for AI outline/chapter/blurb generation.
GEMINI_API_KEY=
# Gemini model for chapter summaries ("Chapter recap"). Optional; default
# gemini-2.5-flash, the same model as the other AI writing features.
SUMMARY_MODEL=

# AI translation (controller/translationController.js, utils/translationJobs.js).
# Languages are listed in config/translationLanguages.js. All optional.
#
# Gemini model for translations. Default gemini-2.5-flash.
TRANSLATION_MODEL=
# Characters of source text per Gemini request (1000–20000). Default 6000.
# Chapters are split between paragraphs, never inside one.
TRANSLATION_CHUNK_CHARS=
# Minimum milliseconds between the starts of two translation requests.
# Default 0. On the free tier, e.g. 6000 (10 per minute) avoids most
# per-minute limit hits; they're waited out automatically either way, and a
# daily limit marks chapters "Waiting for quota" (finished parts are kept).
TRANSLATION_MIN_INTERVAL_MS=

# Cloudinary — cover images and chapter images are uploaded here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (password reset links, purchase notifications). utils/sendEmail.js
# picks the transport:
#
# Brevo HTTPS API — REQUIRED on Render (its free tier blocks outbound SMTP,
# so Gmail SMTP below can never connect there). BREVO_API_KEY is from
# Brevo > SMTP & API > API Keys; EMAIL_FROM must be a sender address you've
# verified under Brevo > Senders (a plain Gmail address works).
BREVO_API_KEY=
EMAIL_FROM=

# Gmail SMTP — fallback only, used when BREVO_API_KEY is unset (e.g. local
# dev). GMAIL_APP_PASSWORD is a Gmail App Password, not the account's real
# login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Audiobook narration (controller/audioController.js, utils/audioJobs.js).
# Uses GEMINI_API_KEY and the CLOUDINARY_* vars above. All optional.
#
# Which engine the server uses to generate narration:
#   gemini (default) — Gemini TTS; counts toward its quota and the cap below.
#   local            — Kokoro-82M on this machine's CPU, free and offline.
#                      Only for a backend running on your own PC, after
#                      `npm install --prefix scripts/local-tts`. Leave unset
#                      on Render (not enough memory, package not installed).
# To narrate for free without changing this, run on your PC instead:
#   node scripts/narrate-book.js <bookId>      (from backend/; see the script)
AUDIO_PROVIDER=
# Kokoro precision for local narration: fp32 (default; faster on most
# laptop CPUs, 311MB download) or q8 (89MB, slower on older CPUs).
LOCAL_TTS_DTYPE=
#
# Gemini text-to-speech model. Default: gemini-3.8-flash-tts (the
# non-preview model). Others that work: gemini-3.8-flash-lite-tts,
# gemini-2.5-flash-preview-tts, gemini-2.5-pro-preview-tts.
TTS_MODEL=
# Max characters sent to text-to-speech per UTC day, across all admins
# (cost/abuse cap). Default 100000 ≈ 2 hours of narration.
AUDIO_DAILY_CHAR_LIMIT=
# How long a reader's signed audio URL works, in seconds (300–7200).
# Default 3600. The player fetches fresh URLs when one expires.
AUDIO_URL_TTL_SECONDS=
# Gemini TTS requests in flight per chapter (1–4). Default 1, which suits
# the free tier; raise it on a paid tier for faster generation.
AUDIO_TTS_CONCURRENCY=
# Minimum milliseconds between the starts of two Gemini TTS requests.
# Default 0 (no spacing). On the free tier, e.g. 20000 (3 per minute) avoids
# most per-minute limit hits. Per-minute limits are waited out and retried
# automatically either way; a daily limit stops generation and marks
# chapters "Waiting for quota" (finished parts are kept).
AUDIO_TTS_MIN_INTERVAL_MS=

# Who gets the "new purchase request" / "purchase request resubmitted" admin
# emails (controller/purchaseController.js). Comma-separated for several
# inboxes. OPTIONAL: if unset, every user with role 'admin' is emailed.
#   ADMIN_NOTIFY_EMAIL=orders@example.com
ADMIN_NOTIFY_EMAIL=

# The single canonical production frontend URL. Used for things that only
# ever want ONE real answer: password-reset email links (authController.js)
# and the OG-preview crawler redirect (routes/ogPreviewRoute.js). NOT used
# for CORS — see ALLOWED_ORIGINS below for that. Defaults to
# http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# --- Passkeys ("Sign in with fingerprint / Face ID / screen lock") ---
# (controller/passkeyController.js, config/webauthn.js). All optional; the
# defaults come from FRONTEND_URL. The API (Render) and the site (Vercel)
# are on different domains: a passkey belongs to the SITE's domain, so these
# describe the frontend, never the API.
#   WEBAUTHN_ORIGIN  frontend origin(s) the browser reports, comma-separated
#                    if more than one. Default: FRONTEND_URL.
#   WEBAUTHN_RP_ID   the domain passkeys are bound to. Default: the host of
#                    the first origin, e.g. kenlibs-sooty.vercel.app. Must be
#                    that host or a parent domain of it (a custom domain
#                    like kenlibs.ng can cover www.kenlibs.ng; vercel.app
#                    itself can't be used, so preview URLs never get
#                    passkeys).
#   WEBAUTHN_RP_NAME shown by the phone/browser. Default: Kenlibs.
# WARNING: CHANGING THE RP ID (e.g. moving to a custom domain) MAKES EVERY
# EXISTING PASSKEY STOP WORKING. Readers then sign in with their password
# and add a new passkey; passwords are never affected.
# Production example (Render):
#   WEBAUTHN_ORIGIN=https://kenlibs-sooty.vercel.app
#   WEBAUTHN_RP_ID=kenlibs-sooty.vercel.app
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=

# --- Brute-force limits for the password endpoints ---
# (middleware/authRateLimits.js). All optional, safe defaults shown. Only
# FAILED logins count; a successful login clears that IP + email's count.
# Over a limit: 429 "Too many attempts. Please wait N minutes", except the
# per-email forgot-password limit, which answers the usual generic 200 but
# sends no more emails. Kept in memory per server process.
AUTH_LOGIN_WINDOW_MINUTES=15
# Failed logins for one IP + email in the window.
AUTH_LOGIN_MAX_FAILS_PER_IP_EMAIL=10
# Failed logins for one IP across all emails in the window (looser; on a
# shared network, other people's failures count toward this one).
AUTH_LOGIN_MAX_FAILS_PER_IP=100
# Per hour.
AUTH_FORGOT_MAX_PER_IP=20
AUTH_FORGOT_MAX_PER_EMAIL=5
AUTH_REGISTER_MAX_PER_IP=10
AUTH_RESET_MAX_PER_IP=20

# Public share link (/read/:shareId → GET /api/public/books/:shareId) shows
# a preview only: this many chapters get an excerpt (their first ~1,500
# characters, cut at a paragraph boundary); every other chapter is a locked
# title. 0–20, default 1 (0 = table of contents only). The full book is only
# available to readers with access, in the gated reader.
SHARE_PREVIEW_CHAPTERS=

# Error monitoring (utils/errorLogger.js, admin page /admin/errors).
# Backend 5xx errors, failed background jobs and readers' browser errors,
# grouped by fingerprint, scrubbed of emails/tokens. All optional.
#   ERROR_LOG_ENABLED         on unless "false" (off in tests unless a test turns it on)
#   ERROR_LOG_TTL_DAYS        entries delete themselves this long after last seen (default 30)
#   ERROR_ALERT_MAX_PER_HOUR  alert emails to ADMIN_NOTIFY_EMAIL per hour (default 5; 0 = none)
#   ERROR_ALERT_SPIKE_PER_HOUR  occurrences in an hour that count as a spike alert (default 50)
#   RELEASE                   release label stored with errors (default: Render's RENDER_GIT_COMMIT)
#   TRUST_PROXY               proxy hops in front of the API, for per-IP rate limits
#                             (default 1 on Render, off elsewhere)
ERROR_LOG_ENABLED=true
ERROR_LOG_TTL_DAYS=30
ERROR_ALERT_MAX_PER_HOUR=5
ERROR_ALERT_SPIKE_PER_HOUR=50
RELEASE=
TRUST_PROXY=

# Anonymous book-page view counting for the admin analytics funnel
# (controller/bookViewController.js). Optional; on unless set to "false".
# Stores only a per-book, per-day total (BookViewDaily): no IP, account,
# cookie or fingerprint. The browser sends at most one view per book per
# day; known bots and prefetches are ignored; 60 requests/10 min per IP.
BOOK_VIEW_TRACKING_ENABLED=

# Most highlights + bookmarks one reader can keep in one book
# (controller/annotationController.js). Optional; default 2000.
READER_ANNOTATIONS_MAX_PER_BOOK=

# CORS allowlist — comma-separated, no spaces needed around commas (they're
# trimmed). Falls back to FRONTEND_URL alone if unset. Include every real
# origin that calls this API: production frontend, plus any specific Vercel
# preview URLs you're actively testing against.
#   ALLOWED_ORIGINS=https://kenlibs.app,https://kenlibs-admin.app
ALLOWED_ORIGINS=

# OPTIONAL, opt-in only. A single-wildcard host pattern (one `*` = one DNS
# label) additionally allowed for CORS on top of ALLOWED_ORIGINS — intended
# for Vercel's unpredictable per-branch/PR preview subdomains so you don't
# have to hand-add every preview URL to ALLOWED_ORIGINS. Leave unset in
# production unless you specifically want preview deploys able to call the
# live API. See app.js's ORIGIN_PATTERN comment for exactly what this does
# and doesn't match.
#   ALLOWED_ORIGIN_PATTERN=https://*.vercel.app
ALLOWED_ORIGIN_PATTERN=
