# Server port. Render sets this itself in production — safe to leave unset
# there. Only matters for local dev (defaults to 5000 if unset).
PORT=8000

# MongoDB Atlas connection string. No fallback — the app fails fast at
# startup if this is missing rather than silently pointing at nothing.
MONGO_URI=

# Secret used to sign/verify JWTs. Use a long random value in production —
# anyone who has this can mint valid tokens for any user.
JWT_SECRET=

# Gemini API key for AI outline/chapter/blurb generation.
GEMINI_API_KEY=

# Cloudinary — cover images and chapter images are uploaded here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (interim email transport — see utils/sendEmail.js for why this
# isn't a dedicated provider yet). GMAIL_APP_PASSWORD is a Gmail App
# Password, not the account's real login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The single canonical production frontend URL. Used for things that only
# ever want ONE real answer: password-reset email links (authController.js)
# and the OG-preview crawler redirect (routes/ogPreviewRoute.js). NOT used
# for CORS — see ALLOWED_ORIGINS below for that. Defaults to
# http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# CORS allowlist — comma-separated, no spaces needed around commas (they're
# trimmed). Falls back to FRONTEND_URL alone if unset. Include every real
# origin that calls this API: production frontend, plus any specific Vercel
# preview URLs you're actively testing against.
#   ALLOWED_ORIGINS=https://kenlibs.app,https://kenlibs-admin.app
ALLOWED_ORIGINS=

# OPTIONAL, opt-in only. A single-wildcard host pattern (one `*` = one DNS
# label) additionally allowed for CORS on top of ALLOWED_ORIGINS — intended
# for Vercel's unpredictable per-branch/PR preview subdomains so you don't
# have to hand-add every preview URL to ALLOWED_ORIGINS. Leave unset in
# production unless you specifically want preview deploys able to call the
# live API. See app.js's ORIGIN_PATTERN comment for exactly what this does
# and doesn't match.
#   ALLOWED_ORIGIN_PATTERN=https://*.vercel.app
ALLOWED_ORIGIN_PATTERN=
